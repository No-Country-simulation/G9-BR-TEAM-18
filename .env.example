# =============================================================================
# EnergIAI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- API URLs ---
VITE_API_URL=http://localhost:8080
ML_SERVICE_URL=http://ml-service:8000

# --- Server Ports ---
SERVER_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ===================================================================
# Database — PostgreSQL (docker-compose / Render)
#
#     O application.properties NÃO tem defaults — consome exclusivamente
#     estas variáveis. Se faltar alguma, o Spring Boot falha na inicialização.
#
# Docker: o docker-compose.yml injeta este .env via env_file.
# Render: configure cada uma no dashboard do serviço.
#
# Para migrar para Oracle ATP (OCI) no futuro:
#   - Comente este bloco
#   - Descomente o bloco Oracle abaixo
#   - Descomente as dependências Oracle no pom.xml
# ===================================================================

# --- PostgreSQL (ativo) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/energiaia
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=energiaia
SPRING_DATASOURCE_PASSWORD=energiaia123
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_JPA_SHOW_SQL=false

# --- Oracle ATP (OCI — produção futura) ---
# Descomente este bloco e comente o PostgreSQL acima quando migrar
# SPRING_DATASOURCE_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-saopaulo-1.oraclecloud.com))(connect_data=(service_name=gd9aa7eb4c94693_dbenergiai_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
# SPRING_DATASOURCE_USERNAME=ADMIN
# SPRING_DATASOURCE_PASSWORD=
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.OracleDialect
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# ORACLE_WALLET_LOCATION=/etc/secrets/Wallet_DBNAME

# --- ML Service ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MODEL_PATH=categorization-model.joblib
TRAINING_LOG_PATH=treino_feedback.jsonl
GROQ_MAX_RPM=25
GROQ_MAX_RPD=900

# --- Business Configuration ---
KWH_TARIFF=0.75
CO2_EMISSION_FACTOR=0.096

# --- CORS & Security ---
CORS_ALLOWED_ORIGINS=*
SESSION_MAX_AGE_SECONDS=604800
SESSION_SECURE=false

# --- ML Training ---
RANDOM_SEED=42
N_SYNTHETIC=4000
FEEDBACK_WEIGHT=5
