# =============================================================================
# EnergIAI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- API URLs ---
VITE_API_URL=http://localhost:8080
ML_SERVICE_URL=http://ml-service:8000

# --- Server Ports ---
SERVER_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=5173

# --- Database (H2 in-memory for dev; PostgreSQL for production) ---
SPRING_DATASOURCE_URL=jdbc:h2:mem:energiai
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console

# --- ML Service ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
MODEL_PATH=categorization-model.joblib
TRAINING_LOG_PATH=treino_feedback.jsonl
GROQ_MAX_RPM=25
GROQ_MAX_RPD=900

# --- Business Configuration ---
KWH_TARIFF=0.75
CO2_EMISSION_FACTOR=0.096

# --- CORS & Security ---
CORS_ALLOWED_ORIGINS=*
SESSION_MAX_AGE_SECONDS=604800
SESSION_SECURE=false

# --- ML Training ---
RANDOM_SEED=42
N_SYNTHETIC=4000
FEEDBACK_WEIGHT=5
