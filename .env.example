# =============================================================================
# EnergIAI - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# =============================================================================
# OBRIGATORIO - Configurar no Render (backend)
# =============================================================================
# Variaveis que o backend Spring Boot exige para iniciar.
# Sem elas: erro "No value provided for placeholder" no startup.

# --- API URLs ---
VITE_API_URL=http://localhost:8080
# OBRIGATORIO - URL base exposta no OpenAPI/Swagger (lista de servers).
# Local: http://localhost:8080 | Render: https://seu-backend.onrender.com
# Sem esta variavel o backend NAO inicia (fail-fast de seguranca).
OPENAPI_SERVER_URL=http://localhost:8080
# SSO Google (B057/ADR-0052): Client ID do OAuth2 para o backend validar o ID Token.
# Em dev local pode usar o valor mock para o app subir; para SSO real, criar
# OAuth Client ID em console.cloud.google.com e usar em backend (GOOGLE_CLIENT_ID)
# e frontend (VITE_GOOGLE_CLIENT_ID) com o MESMO valor.
GOOGLE_CLIENT_ID=mock-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=mock-client-id.apps.googleusercontent.com

# --- Server Ports ---
SERVER_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=5173

# =============================================================================
# Database - Oracle ATP
# =============================================================================
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@(description=...)
SPRING_DATASOURCE_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
SPRING_DATASOURCE_USERNAME=ADMIN
SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.OracleDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Flyway (migracoes de banco) ---
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration/oracle
SPRING_FLYWAY_DEFAULT_SCHEMA=ADMIN
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0
# ATENCAO: No Render (ou qualquer provider de env vars flat),
# NAO use ${VAR} aninhado. Copie os MESMOS valores do datasource:
# SPRING_FLYWAY_URL deve ser IDENTICO a SPRING_DATASOURCE_URL
# SPRING_FLYWAY_USER deve ser IDENTICO a SPRING_DATASOURCE_USERNAME
# SPRING_FLYWAY_PASSWORD deve ser IDENTICO a SPRING_DATASOURCE_PASSWORD
SPRING_FLYWAY_URL=
SPRING_FLYWAY_USER=
SPRING_FLYWAY_PASSWORD=

# --- Seguranca JWT ---
JWT_SECRET=gerar-uma-chave-aleatoria-de-no-minimo-32-caracteres
JWT_EXPIRATION_MS=604800000
SESSION_SECURE=false
CORS_ALLOWED_ORIGINS=*

# --- Google OAuth SSO (ADR 052) ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# --- ML Service Integration ---
ML_SERVICE_URL=http://ml-service:8000
ML_OUTPUT_FIELD_CATEGORY=category
ML_OUTPUT_FIELD_PROBABILITY=probability
ML_OUTPUT_FIELD_RECOMMENDATIONS=recommendations
ML_OUTPUT_FIELD_SOURCE=source
ML_DEFAULT_CATEGORIES=EXCELENTE,BOM,MEDIANO,RUIM,CRITICO

# =============================================================================
# OPCIONAL - Valores sugeridos (nao quebram o startup se ausentes)
# =============================================================================

SPRING_JPA_SHOW_SQL=false
# ORACLE_WALLET_LOCATION=/etc/secrets/Wallet_DBNAME

# --- ML Service Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MODEL_PATH=categorization-model.joblib
TRAINING_LOG_PATH=treino_feedback.jsonl
GROQ_MAX_RPM=25
GROQ_MAX_RPD=900

# --- Business Configuration ---
KWH_TARIFF=0.75
CO2_EMISSION_FACTOR=0.096

# --- Session ---
SESSION_MAX_AGE_SECONDS=604800

# --- ML Training ---
RANDOM_SEED=42
N_SYNTHETIC=4000
FEEDBACK_WEIGHT=5
