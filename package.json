{
  "name": "energiai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#target\" \"#dist\" \"#.git\" \"#ml-service/data\"",
    "lint:spell": "cspell \"**/*.{md,ts,tsx,java,py,json,yaml,yml}\"",
    "lint:chars": "node scripts/check-forbidden-chars.mjs $(find . -type f \\( -name '*.md' -o -name '*.ts' -o -name '*.tsx' -o -name '*.java' -o -name '*.py' -o -name '*.json' -o -name '*.yml' -o -name '*.yaml' \\) -not -path './node_modules/*' -not -path './.git/*' -not -path './target/*' -not -path './dist/*' -not -path './ml-service/data/*' 2>/dev/null)",
    "lint:docs": "npm run lint:markdown && npm run lint:spell && npm run lint:chars",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.14.0",
    "cspell": "^8.14.0",
    "@cspell/dict-pt-br": "^1.0.0"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2 --fix",
      "cspell --no-must-find-files",
      "node scripts/check-forbidden-chars.mjs"
    ],
    "*.{ts,tsx}": [
      "cspell --no-must-find-files",
      "node scripts/check-forbidden-chars.mjs"
    ],
    "*.{java,py,json,yaml,yml}": [
      "cspell --no-must-find-files",
      "node scripts/check-forbidden-chars.mjs"
    ]
  }
}
