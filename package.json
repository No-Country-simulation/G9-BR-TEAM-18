{
  "name": "energiai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#target\" \"#dist\" \"#.git\" \"#ml-service/data\"",
    "lint:spell": "cspell $(git ls-files \"*.md\")",
    "lint:chars": "node scripts/check-forbidden-chars.mjs $(git ls-files \"*.md\")",
    "lint:docs": "npm run lint:markdown && npm run lint:spell && npm run lint:chars",
    "lint:java": "sh -c 'docker run --rm --volume m2_cache:/root/.m2 -v $(pwd):/workspace -w /workspace/backend maven:3.9-eclipse-temurin-21 mvn -q spotless:apply'",
    "lint:python-check": "sh -c 'docker run --rm -v $(pwd):/workspace -w /workspace/ml-service ghcr.io/astral-sh/ruff:latest check --fix'",
    "lint:python-format": "sh -c 'docker run --rm -v $(pwd):/workspace -w /workspace/ml-service ghcr.io/astral-sh/ruff:latest format'",
    "lint:frontend-lint": "cd frontend && npx eslint --fix",
    "lint:frontend-format": "cd frontend && npx prettier --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.14.0",
    "cspell": "^8.14.0",
    "@cspell/dict-pt-br": "^1.0.0"
  },
  "lint-staged": {
    "backend/**/*.java": [
      "npm run lint:java"
    ],
    "ml-service/**/*.py": [
      "npm run lint:python-check",
      "npm run lint:python-format"
    ],
    "frontend/**/*.{ts,tsx}": [
      "npm run lint:frontend-lint",
      "npm run lint:frontend-format"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "cspell --no-must-find-files",
      "node scripts/check-forbidden-chars.mjs"
    ],
    "**/*.{yml,yaml}": [
      "yamllint"
    ],
    "**/Dockerfile*": [
      "hadolint"
    ]
  }
}
