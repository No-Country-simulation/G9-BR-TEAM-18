{
  "name": "energiai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#target\" \"#dist\" \"#.git\" \"#ml-service/data\"",
    "lint:spell": "cspell $(git ls-files \"*.md\")",
    "lint:chars": "node scripts/check-forbidden-chars.mjs $(git ls-files \"*.md\")",
    "lint:docs": "npm run lint:markdown && npm run lint:spell && npm run lint:chars",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.14.0",
    "cspell": "^8.14.0",
    "@cspell/dict-pt-br": "^1.0.0"
  },
  "lint-staged": {
    "backend/**/*.java": [
      "cd backend && mvn -q spotless:apply"
    ],
    "ml-service/**/*.py": [
      "cd ml-service && ruff check --fix",
      "cd ml-service && ruff format"
    ],
    "frontend/**/*.{ts,tsx}": [
      "cd frontend && npx eslint --fix",
      "cd frontend && npx prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "cspell --no-must-find-files",
      "node scripts/check-forbidden-chars.mjs"
    ],
    "**/*.{yml,yaml}": [
      "yamllint"
    ],
    "**/Dockerfile*": [
      "hadolint"
    ]
  }
}
